{
  "name": "csv-to-tableur",
  "displayName": "CSV to Tableur",
  "description": "Open CSV/TSV files as a spreadsheet: sorting, Excel-style filters, row count, statistics, editing.",
  "icon": "images/icon.png",
  "version": "0.1.0",
  "publisher": "brieucInc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Brieuclantivy/csv-to-tableur.git"
  },
  "bugs": {
    "url": "https://github.com/Brieuclantivy/csv-to-tableur/issues"
  },
  "homepage": "https://github.com/Brieuclantivy/csv-to-tableur#readme",
  "keywords": [
    "csv",
    "tsv",
    "spreadsheet",
    "excel",
    "filter",
    "sort",
    "table",
    "grid",
    "viewer",
    "tableur"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/core.test.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "csvViewer.editor",
        "displayName": "CSV to Tableur",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "csvViewer.open",
        "title": "Open in CSV to Tableur",
        "icon": "$(table)"
      },
      {
        "command": "csvViewer.openText",
        "title": "Open as text",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "csvViewer.open",
          "when": "resourceExtname =~ /^\\.(csv|tsv)$/i && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "csvViewer.openText",
          "when": "activeCustomEditorId == csvViewer.editor",
          "group": "navigation"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.0"
  }
}
